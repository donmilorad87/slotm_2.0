# ==============================================
# slotm – Docker Environment Configuration
# ==============================================
# Copy to .env and fill in real values.

# ---- Build ----
# Runtime mode for node container: dev | prod
ENV=dev
BUILD_ENV=dev

# ---- Application ----
APP_HOST=0.0.0.0
APP_PORT=4300
NODE_ENV=development

# ---- PostgreSQL ----
POSTGRES_HOST=172.30.0.11
POSTGRES_PORT=5432
POSTGRES_USER=slotm
POSTGRES_PASSWORD=slotm_secret_change_me
POSTGRES_DB=slotm

# ---- pgAdmin ----
PGADMIN_EMAIL=admin@slotm.dev
PGADMIN_PASSWORD=pgadmin_secret_change_me

# ---- JWT ----
JWT_SECRET=
JWT_EXPIRES_IN=14d
