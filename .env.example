# ==============================================
# slotm – Docker Environment Configuration
# ==============================================

# ---- Build ----
# Runtime mode for node container: dev | prod
ENV=dev
BUILD_ENV=dev

# ---- Application ----
APP_HOST=0.0.0.0
APP_PORT=4300
NODE_ENV=development

# ---- PostgreSQL ----
POSTGRES_HOST=172.30.0.11
POSTGRES_PORT=5432
POSTGRES_USER=slotm
POSTGRES_PASSWORD=slotm_secret_change_me
POSTGRES_DB=slotm

# ---- pgAdmin ----
PGADMIN_EMAIL=admin@slotm.dev
PGADMIN_PASSWORD=pgadmin_secret_change_me

# ---- JWT ----
JWT_SECRET=slotm_jwt_secret_change_me
JWT_EXPIRES_IN=14d

# ---- Claude Code CLI (Brand Compliance AI judgment) ----
# Generate with `claude setup-token` (format sk-ant-oat01-...). Optional:
# without it, deterministic brand checks still run; only AI judgment is skipped.
CLAUDE_CODE_OAUTH_TOKEN=
# Model for AI judgment checks. "haiku" = fastest/cheapest, "sonnet" = balanced
# (default), "opus" = slowest. Judgment checks run one CLI call per slide.
CLAUDE_MODEL=sonnet
