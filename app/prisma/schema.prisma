generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     Int       @id @default(autoincrement())
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  passwordSalt           String    @map("password_salt")
  balanceUnits           Int       @default(0) @map("balance_units")
  stripeCustomerId       String?   @map("stripe_customer_id")
  defaultPaymentMethodId String?   @map("default_payment_method_id")
  firstName              String?   @map("first_name")
  lastName               String?   @map("last_name")
  profilePicture         String?   @map("profile_picture")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  sessions         Session[]
  transactions     Transaction[]
  gameHistories    GameHistory[]
  pendingMiniGames PendingMiniGame[]
  analysisSets     AnalysisSet[]

  @@map("users")
}

// --- Brand Compliance Checker ---------------------------------------------

model Guideline {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  markdown  String
  version   Int      @default(1)
  updatedBy Int?     @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("guidelines")
}

model DeterministicRule {
  id          Int      @id @default(autoincrement())
  ruleType    String   @map("rule_type") // font_size | font_color | font_family | forbidden_text
  scope       String   @default("any") // title | body | any
  numberValue Int?     @map("number_value") // e.g. font size in pt
  textValue   String?  @map("text_value") // hex (no #), family name, or forbidden text
  severity    String   @default("warning")
  autoFix     Boolean  @default(true) @map("auto_fix")
  enabled     Boolean  @default(true)
  name        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("deterministic_rules")
}

model AnalysisSet {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  title        String
  status       String   @default("uploaded")
  phase        String   @default("uploaded")
  slideCount   Int      @default(0) @map("slide_count")
  guidelineId  Int?     @map("guideline_id")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  files  AnalysisFile[]
  flags  Flag[]
  slides SlideRender[]

  @@index([userId])
  @@map("analysis_sets")
}

model AnalysisFile {
  id            Int      @id @default(autoincrement())
  analysisSetId Int      @map("analysis_set_id")
  kind          String
  filename      String
  publicPath    String   @map("public_path")
  byteSize      Int      @default(0) @map("byte_size")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  analysisSet AnalysisSet @relation(fields: [analysisSetId], references: [id], onDelete: Cascade)

  @@index([analysisSetId])
  @@map("analysis_files")
}

model SlideRender {
  id            Int      @id @default(autoincrement())
  analysisSetId Int      @map("analysis_set_id")
  slideIndex    Int      @map("slide_index")
  kind          String   @default("annotated")
  imageFilename String   @map("image_filename")
  publicPath    String   @map("public_path")
  widthEmu      Int      @default(0) @map("width_emu")
  heightEmu     Int      @default(0) @map("height_emu")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  analysisSet AnalysisSet @relation(fields: [analysisSetId], references: [id], onDelete: Cascade)

  @@unique([analysisSetId, slideIndex, kind])
  @@map("slide_renders")
}

model Flag {
  id            Int      @id @default(autoincrement())
  analysisSetId Int      @map("analysis_set_id")
  slideIndex    Int      @map("slide_index")
  ruleId        String   @map("rule_id")
  category      String
  severity      String   @default("warning")
  status        String   @default("pending")
  message       String
  locationJson  String?  @map("location_json")
  suggestedFix  String?  @map("suggested_fix")
  fixOpJson     String?  @map("fix_op_json")
  autoFixable   Boolean  @default(false) @map("auto_fixable")
  confidence    Float?
  dedupeKey     String   @map("dedupe_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  analysisSet AnalysisSet @relation(fields: [analysisSetId], references: [id], onDelete: Cascade)

  @@unique([analysisSetId, dedupeKey])
  @@index([analysisSetId, slideIndex])
  @@map("flags")
}

model Session {
  id        String   @id
  userId    Int      @map("user_id")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @map("created_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Transaction {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  type              String
  direction         String
  amountUnits       Int      @map("amount_units")
  balanceAfterUnits Int?     @map("balance_after_units")
  description       String?
  provider          String?
  providerRef       String?  @map("provider_ref")
  metadataJson      String?  @map("metadata_json")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  betHistories GameHistory[] @relation("BetTransaction")
  winHistories GameHistory[] @relation("WinTransaction")

  @@index([userId])
  @@map("transactions")
}

model GameHistory {
  id                       Int      @id @default(autoincrement())
  userId                   Int      @map("user_id")
  betTransactionId         Int?     @map("bet_transaction_id")
  winTransactionId         Int?     @map("win_transaction_id")
  reelsJson                String   @map("reels_json")
  gridJson                 String?  @map("grid_json")
  activeLinesJson          String   @map("active_lines_json")
  winningLinesJson         String   @map("winning_lines_json")
  rewardMode               String   @map("reward_mode")
  gameType                 String   @map("game_type")
  betPerLineCoins          Int      @map("bet_per_line_coins")
  totalBetCoins            Int      @map("total_bet_coins")
  totalPayoutCoins         Int      @map("total_payout_coins")
  netResultCoins           Int      @map("net_result_coins")
  jokerEnabled             Boolean  @default(false) @map("joker_enabled")
  jokerPosition            Int?     @map("joker_position")
  jokerCostCoins           Int      @default(0) @map("joker_cost_coins")
  miniGameTriggered        Boolean  @default(false) @map("mini_game_triggered")
  miniGameMode             String?  @map("mini_game_mode")
  miniGamePlayedJson       String?  @map("mini_game_played_json")
  miniGameDrawnJson        String?  @map("mini_game_drawn_json")
  miniGameTotalBetCoins    Int?     @map("mini_game_total_bet_coins")
  miniGameTotalPayoutCoins Int?     @map("mini_game_total_payout_coins")
  miniGameNetResultCoins   Int?     @map("mini_game_net_result_coins")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  betTransaction   Transaction?      @relation("BetTransaction", fields: [betTransactionId], references: [id])
  winTransaction   Transaction?      @relation("WinTransaction", fields: [winTransactionId], references: [id])
  pendingMiniGames PendingMiniGame[]

  @@index([userId])
  @@map("game_history")
}

model PendingMiniGame {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  gameHistoryId Int       @map("game_history_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameHistory GameHistory @relation(fields: [gameHistoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pending_minigame")
}
