<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="icon" type="image/gif" href="/assets/images/blazingSun.gif">
    <link rel="stylesheet" href="/assets/css/main.css">
  </head>
  <body class="theme-blazing-sun">
    <canvas id="canvasss" aria-hidden="true"></canvas>
    <header class="topbar">
      <div class="topbar__left">
        <a class="svemir-logo" href="/" aria-label="Blazing Sun home">
          <img style="height: 4em" src="/assets/images/blazingSun.gif" alt="Blazing Sun logo">
        </a>
        <span class="topbar__muted">Sign in</span>
      </div>
      <nav class="topbar__right">
        <a href="/login?next={{next_path}}">Login</a>
        <a href="/register?next={{next_path}}">Register</a>
      </nav>
    </header>

    <main class="auth-page">
      <section class="auth-card">
        <h1>Sign In</h1>
        <p class="auth-subtitle">Access your wallet and slot history.</p>
        <form id="loginForm" class="auth-form">
          <input type="hidden" name="next" value="{{next_path}}">
          <label>
            Email
            <input type="email" name="email" required autocomplete="email">
          </label>
          <label>
            Password
            <input type="password" name="password" required autocomplete="current-password">
          </label>
          <button class="btn btn--primary" type="submit">Sign In</button>
          <p id="authError" class="form-error"></p>
        </form>
        <p class="auth-switch">No account? <a href="/register?next={{next_path}}">Create one</a></p>
      </section>
    </main>
    <script type="module" src="/assets/js/blazing-background.js"></script>
    <script type="module" src="/assets/js/auth.js"></script>
  </body>
</html>
