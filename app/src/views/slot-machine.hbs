<!doctype html>
<html lang="en" style="background:#141718">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=1024">
    <title>{{title}}</title>
    <link rel="icon" type="image/gif" href="/assets/images/blazingSun.gif">
    <link rel="stylesheet" href="/assets/css/main.css">
  </head>
  <body class="theme-blazing-sun slot-page-fit" style="background:#141718">
    <header class="topbar">
      <div class="topbar__left">
        <a class="blazing-sun-logo" href="/" aria-label="Blazing Sun home">
          <img style="height: 4em" src="/assets/images/blazingSun.gif" alt="Blazing Sun logo">
        </a>
      </div>
      <nav class="topbar__right">
        <a href="/games">Games</a>
        <a href="/compliance">Brand Check</a>
        <div class="topbar__profile">
          <button class="topbar__avatar" type="button" aria-label="Profile menu" aria-haspopup="true" aria-expanded="false">
            {{#if user_profile_picture}}
              <img src="{{user_profile_picture}}" alt="Profile">
            {{else}}
              <span class="topbar__avatar-initials">{{user_initials}}</span>
            {{/if}}
          </button>
          <div class="topbar__dropdown" hidden>
            <a href="/profile">Profile</a>
            <a href="/wallet">Wallet</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </nav>
    </header>

    <main class="game-page">
      <p class="flash-msg">{{flash_message}}</p>

      <section class="game-page__content">
        <section
          id="slotMachineRoot"
          class="slot-machine-root"
          data-balance="{{user_balance_coins}}"
          data-user-id="{{user_id}}"
          data-jwt-token="{{jwt_token}}"
          data-games-url="/games"
        >
          {{{slot_machine_markup}}}
        </section>
      </section>

      <div class="footer" id="footer"><p>Blazing Sun&reg; 2015&ndash;<span id="footerYear"></span>. All rights reserved.</p></div>
    </main>

    <script>
      window.USER_BALANCE_COINS = Number("{{user_balance_coins}}");
      window.JWT_TOKEN = "{{jwt_token}}";
      window.USER_ID = Number("{{user_id}}");
      window.STRIPE_PUBLISHABLE_KEY = "{{stripe_public_key}}";
      var footerYear = document.getElementById("footerYear");
      if (footerYear) {
        footerYear.textContent = String(new Date().getFullYear());
      }

      (function() {
        var btn = document.querySelector('.topbar__avatar');
        var dd = document.querySelector('.topbar__dropdown');
        if (!btn || !dd) return;
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          var open = !dd.hidden;
          dd.hidden = open;
          btn.setAttribute('aria-expanded', String(!open));
        });
        document.addEventListener('click', function() {
          dd.hidden = true;
          btn.setAttribute('aria-expanded', 'false');
        });
        dd.addEventListener('click', function(e) { e.stopPropagation(); });
      })();

      window.showToast = function showToast(message, type) {
        const toast = document.createElement("div");
        toast.className = "toast toast--" + (type || "info");
        toast.textContent = message;
        document.body.appendChild(toast);
        setTimeout(function hide() {
          toast.remove();
        }, 3200);
      };
    </script>
    <script type="module" src="/assets/js/blazing-background.js"></script>
    <script type="module" src="/assets/js/main.js"></script>
    <script type="module" src="/assets/js/slot-page.js"></script>
    <canvas id="space" aria-hidden="true"></canvas>
  </body>
</html>
