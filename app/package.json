{
  "name": "slotm",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash ./scripts/build-and-restart-pm2.sh",
    "build:dist": "node ./scripts/build.mjs && npm run build:server",
    "build:reset": "bash ./scripts/build-and-reset-pm2.sh",
    "build:server": "tsc -p ./tsconfig.backend.json",
    "typecheck": "tsc -p ./tsconfig.backend.json --noEmit",
    "start": "node ./dist/server.js",
    "start:lan": "HOST=0.0.0.0 node ./dist/server.js",
    "dev": "npx nodemon --watch src --watch scripts --watch tsconfig.backend.json --ext ts,js,mjs,cjs,hbs,css --delay 0.4 --exec \"npm run build:dist && node ./dist/server.js\"",
    "dev:once": "npm run build:dist && node ./dist/server.js",
    "dev:nodemon:reset": "npx nodemon --watch src --watch scripts --ext ts,js,mjs,cjs,hbs,css --delay 0.4 --exec \"bash ./scripts/build-and-reset-pm2.sh\"",
    "test:parity": "npm run build:dist && node --test tests/parity/*.test.mjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.2",
    "@types/pg": "^8.16.0",
    "typescript": "^5.9.3"
  }
}
